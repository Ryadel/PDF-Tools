    "configuration": {
      "title": "%displayName%",
      "properties": {
        "pdfTools.print.method": {
          "type": "string",
          "enum": [
            "systemViewer",
            "windowsPrintVerb"
          ],
          "enumDescriptions": [
            "%config.print.method.systemViewer%",
            "%config.print.method.windowsPrintVerb%"
          ],
          "default": "systemViewer",
          "markdownDescription": "%config.print.method%"
        },
        "pdfTools.default.mode": {
          "type": "string",
          "enum": [
            "auto",
            "view",
            "fill"
          ],
          "default": "auto",
          "enumDescriptions": [
            "%config.default.mode.auto%",
            "%config.default.mode.view%",
            "%config.default.mode.fill%"
          ],
          "markdownDescription": "%config.default.mode%"
        },
        "pdfTools.default.scale": {
          "type": "string",
          "default": "auto",
          "pattern": "^(\\d+(?:\\.\\d+)?|auto|page-actual|page-fit|page-width)$",
          "markdownDescription": "%config.default.scale%"
        },
        "pdfTools.default.scrollMode": {
          "type": "string",
          "enum": [
            "vertical",
            "horizontal",
            "wrapped",
            "page"
          ],
          "default": "vertical",
          "markdownDescription": "%config.default.scrollMode%"
        },
        "pdfTools.default.spreadMode": {
          "type": "string",
          "enum": [
            "none",
            "odd",
            "even"
          ],
          "default": "none",
          "markdownDescription": "%config.default.spreadMode%"
        },
        "pdfTools.default.cursor": {
          "type": "string",
          "enum": [
            "select",
            "hand"
          ],
          "default": "select",
          "markdownDescription": "%config.default.cursor%"
        },
        "pdfTools.default.sidebar": {
          "type": "boolean",
          "default": false,
          "markdownDescription": "%config.default.sidebar%"
        },
        "pdfTools.restoreViewState": {
          "type": "boolean",
          "default": true,
          "markdownDescription": "%config.restoreViewState%"
        },
        "pdfTools.toolbar": {
          "type": "string",
          "enum": [
            "fixed",
            "floating"
          ],
          "enumDescriptions": [
            "%config.toolbar.fixed%",
            "%config.toolbar.floating%"
          ],
          "default": "fixed",
          "markdownDescription": "%config.toolbar%"
        },
        "pdfTools.pageColors": {
          "type": "string",
          "enum": [
            "off",
            "theme"
          ],
          "enumDescriptions": [
            "%config.pageColors.off%",
            "%config.pageColors.theme%"
          ],
          "default": "off",
          "markdownDescription": "%config.pageColors%"
        }
      }
    },
    "keybindings": [
      {
        "command": "pdfTools.find",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeCustomEditorId == pdfTools.editor"
      },
      {
        "command": "pdfTools.showSearch",
        "key": "ctrl+shift+f",
        "mac": "cmd+shift+f",
        "when": "activeCustomEditorId == pdfTools.editor"
      },
      {
        "command": "pdfTools.findNext",
        "key": "f3",
        "mac": "cmd+g",
        "when": "activeCustomEditorId == pdfTools.editor"
      },
      {
        "command": "pdfTools.findPrevious",
        "key": "shift+f3",
        "mac": "cmd+shift+g",
        "when": "activeCustomEditorId == pdfTools.editor"
      },
      {
        "command": "pdfTools.goToPage",
        "key": "ctrl+g",
        "mac": "ctrl+g",
        "when": "activeCustomEditorId == pdfTools.editor"
      },
      {
        "command": "pdfTools.zoomIn",
        "key": "ctrl+=",
        "mac": "cmd+=",
        "when": "activeCustomEditorId == pdfTools.editor"
      },
      {
        "command": "pdfTools.zoomIn",
        "key": "ctrl+numpad_add",
        "mac": "cmd+numpad_add",
        "when": "activeCustomEditorId == pdfTools.editor"
      },
      {
        "command": "pdfTools.zoomOut",
        "key": "ctrl+-",
        "mac": "cmd+-",
        "when": "activeCustomEditorId == pdfTools.editor"
      },
      {
        "command": "pdfTools.zoomOut",
        "key": "ctrl+numpad_subtract",
        "mac": "cmd+numpad_subtract",
        "when": "activeCustomEditorId == pdfTools.editor"
      },
      {
        "command": "pdfTools.zoomActual",
        "key": "ctrl+0",
        "mac": "cmd+0",
        "when": "activeCustomEditorId == pdfTools.editor"
      },
      {
        "command": "pdfTools.back",
        "key": "alt+left",
        "mac": "cmd+[",
        "when": "activeCustomEditorId == pdfTools.editor && pdfTools.canGoBack"
      },
      {
        "command": "pdfTools.forward",
        "key": "alt+right",
        "mac": "cmd+]",
        "when": "activeCustomEditorId == pdfTools.editor && pdfTools.canGoForward"
      },
      {
        "command": "pdfTools.presentationMode",
        "key": "ctrl+alt+p",
        "mac": "cmd+alt+p",
        "when": "activeCustomEditorId == pdfTools.editor"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package:build",
    "build": "npm run check-types && npm run lint && node scripts/build.mjs",
    "package:build": "npm run check-types && npm run lint && node scripts/build.mjs --production",
    "watch:esbuild": "node scripts/build.mjs --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "check-types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p webview/tsconfig.json",
    "lint": "eslint src webview test && node scripts/l10n-extract.mjs --check",
    "compile-tests": "tsc -p test/tsconfig.json",
    "test:unit": "npm run compile-tests && node --test \"out/test/unit/**/*.test.mjs\"",
    "pretest": "npm run compile-tests && node scripts/build.mjs",
    "test": "vscode-test",
    "package": "vsce package --no-dependencies",
    "l10n": "node scripts/l10n-extract.mjs"
  },
  "devDependencies": {
    "@cantoo/pdf-lib": "2.11.1",
    "@eslint/js": "10.0.1",
    "@types/mocha": "10.0.10",
    "@types/node": "24.19.1",
    "@types/vscode": "1.125.0",
    "@vscode/codicons": "0.0.46-24",
    "@vscode/test-cli": "0.0.15",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "eslint": "10.12.0",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "6.4.299",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.1"
  },
  "overrides": {
    "diff": "^9.0.0",
    "serialize-javascript": "^7.1.2"
  },
  "activationEvents": [
    "onUri"
  ],
  "l10n": "./l10n"
